# SMTP Configuration for sending real emails
# For Gmail: Use your Gmail address and a 16-character Google App Password (not your normal password).
# How to get App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Optional Custom Sender
EMAIL_FROM="BlueCascade Assessments <your_email@gmail.com>"
